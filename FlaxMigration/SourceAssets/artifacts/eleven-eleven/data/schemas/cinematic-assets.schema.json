{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eleven-eleven.local/schemas/cinematic-assets.schema.json",
  "title": "11:11 Cinematic Assets",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "sources",
          "mimeType",
          "byteSize",
          "preloadGroup"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^asset_.+" },
          "kind": {
            "enum": [
              "background",
              "characterPose",
              "voice",
              "music",
              "ambience",
              "sfx"
            ]
          },
          "sources": {
            "type": "object",
            "required": ["android"],
            "properties": {
              "android": { "type": "string", "minLength": 1 },
              "web": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "mimeType": {
            "enum": [
              "image/avif",
              "image/webp",
              "audio/ogg",
              "audio/mp4"
            ]
          },
          "byteSize": { "type": "integer", "minimum": 0 },
          "durationMs": { "type": "integer", "minimum": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "preloadGroup": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
