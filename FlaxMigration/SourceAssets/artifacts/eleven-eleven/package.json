{
  "name": "eleven-eleven",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node ./tools/dev-full-stack.mjs",
    "dev:web": "vite --config vite.config.ts --host 0.0.0.0 --strictPort",
    "dev:api": "wrangler pages dev public --port 8788 --log-level warn --show-interactive-dev-session=false",
    "dev:realtime": "wrangler dev --config workers/realtime/wrangler.jsonc --port 8790",
    "dev:check": "node ./tools/dev-full-stack.mjs --check",
    "native:sync": "node ./tools/prepare-native.mjs",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false",
    "typecheck:realtime": "tsc --noEmit -p workers/realtime/tsconfig.json --pretty false",
    "types:realtime": "wrangler types workers/realtime/worker-configuration.d.ts --config workers/realtime/wrangler.jsonc",
    "check:realtime": "npm run types:realtime && npm run typecheck:realtime && wrangler deploy --dry-run --config workers/realtime/wrangler.jsonc",
    "test": "tsx --test src/__tests__/*.test.ts",
    "test:realtime": "vitest run --config vitest.realtime.config.ts",
    "validate:content": "tsx tools/validate-content.ts",
    "manhwa:import": "node tools/manhwa/import-publication.mjs",
    "manhwa:validate": "node tools/manhwa/validate-publication.mjs",
    "check": "npm run validate:content && npm run typecheck && npm test && npm run build",
    "doctor": "node ./tools/project-doctor/index.mjs doctor",
    "doctor:counts": "node ./tools/project-doctor/index.mjs doctor:counts",
    "doctor:white-screen": "node ./tools/project-doctor/index.mjs doctor:white-screen",
    "doctor:storage": "node ./tools/project-doctor/index.mjs doctor:storage",
    "doctor:files": "node ./tools/project-doctor/index.mjs doctor:files",
    "doctor:build": "node ./tools/project-doctor/index.mjs doctor:build",
    "agent:preflight": "node ./tools/project-doctor/index.mjs agent:preflight",
    "agent:postflight": "node ./tools/project-doctor/index.mjs agent:postflight",
    "media:validate": "npm --prefix ../.. run media:validate"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@radix-ui/react-separator": "^1.1.13",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.1.1",
    "@tanstack/react-query": "^5.0.0",
    "@tauri-apps/api": "^2.11.1",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.20.0",
    "phaser": "^3.90.0",
    "postprocessing": "^6.39.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "wouter": "^3.3.5",
    "zod": "^3.25.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@napi-rs/canvas": "1.0.8",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.8.0",
    "pdfjs-dist": "6.3.289",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "~5.9.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "undici": "7.29.0"
  }
}
